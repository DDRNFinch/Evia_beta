{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evia.local/schemas/course-bundle-v1.json",
  "title": "Evia Downloadable Course Bundle v1",
  "type": "object",
  "required": [
    "eviaCourseBundle",
    "schemaVersion",
    "enrolmentId",
    "bundleVersion",
    "course"
  ],
  "properties": {
    "eviaCourseBundle": { "const": 1 },
    "schemaVersion": { "const": 1 },
    "enrolmentId": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "bundleVersion": {
      "type": "string",
      "minLength": 1
    },
    "qualificationId": {
      "type": "string",
      "minLength": 1
    },
    "pathwayId": {
      "type": ["string", "null"]
    },
    "course": {
      "type": "object",
      "required": ["nisiCoursePack", "schemaVersion", "id", "title"]
    },
    "arp": {
      "type": "object",
      "default": {},
      "properties": {
        "multipleChoice": { "$ref": "#/$defs/bank" },
        "discussion": { "$ref": "#/$defs/bank" },
        "practical": { "$ref": "#/$defs/bank" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "bank": {
      "type": "object",
      "required": ["schemaVersion", "items"],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "string"
        },
        "items": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
